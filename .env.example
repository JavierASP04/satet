# Copiar a .env en la raíz del repositorio: cp .env.example .env
# Ambas aplicaciones (apps/api y apps/web) leen este archivo.

# --- General ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4390
# Origen permitido por CORS (URL del frontend)
WEB_ORIGIN=http://localhost:5390

# --- Base de datos (docker-compose: servicio postgres) ---
POSTGRES_USER=satet
POSTGRES_PASSWORD=satet
POSTGRES_DB=satet
POSTGRES_PORT=5433
DATABASE_URL=postgres://satet:satet@localhost:5433/satet

# --- Redis (docker-compose: servicio redis) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Autenticación (Módulo 01, aún no implementado) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=satet_session

# --- Frontend (apps/web) ---
# URL de la API usada desde el servidor de SvelteKit
API_URL=http://localhost:4390
